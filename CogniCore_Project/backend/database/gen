// ============================================================
// UNIVERSITY REALM GENERATOR — 3 sizes, complete column map
// U1_stateuniv.db   SMALL  modern, GPA floats, advisor self-ref
// U2_metrouniv.db   MEDIUM modern + departments live
// U3_institute.db   LARGE  legacy abbreviated, grade codes, YYYYMMDD
// Deterministic. Run: node database/gen_university.js
// ============================================================
import { execSync } from "child_process";
import { writeFileSync, mkdirSync, rmSync } from "fs";
import path from "path";

const __dirname = path.dirname(new URL(import.meta.url).pathname);
const OUT_DIR = path.join(__dirname, "..", "test", "fixtures", "realms", "university");
mkdirSync(OUT_DIR, { recursive: true });

function mulberry32(seed) {
  return function () {
    let t = (seed += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const pick = (rng, arr) => arr[Math.floor(rng() * arr.length)];
const int = (rng, min, max) => Math.floor(rng() * (max - min + 1)) + min;
const esc = (s) => String(s).replace(/'/g, "''");

const FIRST = ["Aarav", "Maya", "Kiran", "Tariq", "Ingrid", "Raj", "Zara", "Omar", "Lena", "Viktor", "Priya", "Hana", "Diego", "Nadia", "Felix", "Aiko", "Samir", "Greta", "Rohan", "Yuki"];
const LAST = ["Patel", "Khan", "Weber", "Silva", "Okafor", "Rossi", "Kim", "Haddad", "Novak", "Tanaka", "Sharma", "Lopez", "Ahmed", "Berger", "Costa", "Devi", "Iyer", "Jain", "Kapoor", "Menon"];
const DEPT_NAMES = ["Computer Science", "Electrical Engineering", "Mechanical Engineering", "Civil Engineering", "Mathematics", "Physics", "Chemistry", "Management"];
const COURSE_NAMES = ["Databases", "Operating Systems", "Data Structures", "Machine Learning", "Thermodynamics", "Structural Analysis", "Quantum Physics", "Organizational Behavior", "Compiler Design", "Signal Processing", "Fluid Mechanics", "Discrete Mathematics"];
const GRADE_CODES = ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "F"];
const GRADE_POINTS = { "A+": 4.0, "A": 4.0, "A-": 3.7, "B+": 3.3, "B": 3.0, "B-": 2.7, "C+": 2.3, "C": 2.0, "C-": 1.7, "D": 1.0, "F": 0.0 };

function generateUniversity(opts) {
  const { name, seed, students: nStudents, courses: nCourses, legacy } = opts;
  const rng = mulberry32(seed);
  const suffix = legacy ? "institute" : name === "U2" ? "metrouniv" : "stateuniv";
  const dbPath = path.join(OUT_DIR, `${name}_${suffix}.db`);
  rmSync(dbPath, { force: true });

  // ============================================================
  // THE COMPLETE MAP — departments, instructors (advisor self-ref!),
  // students, courses, enrollments. DDL + verification through ONLY this.
  // Note: the advisor self-reference is map-native (insAdv points at
  // the same table's PK) — the map handles self-joins natively.
  // ============================================================
  const T = legacy
    ? {
        dep: "depts",   depPk: "dept_id",  depNm: "dept_nm",   depBud: "bud",
        ins: "profs",   insPk: "prof_id",  insNm: "prof_nm",   insDep: "dept_id",   insSal: "sal", insExp: "yrs",   insAdv: "adv_id",
        stu: "stus",    stuPk: "stu_id",   stuNm: "stu_nm",    stuDep: "dept_id",   stuYr: "yr",   stuAdv: "adv_id",
        crs: "crss",    crsPk: "crs_id",   crsCd: "crs_cd",    crsNm: "crs_nm",     crsDep: "dept_id", crsIns: "prof_id", crsCred: "cred", crsCap: "cap",
        enr: "enrs",    enrPk: "enr_id",   enrStu: "stu_id",   enrCrs: "crs_id",    enrGrd: "grade", enrSem: "sem",
        // enrollment grading model for legacy: letter codes, no gpa column
        grading: "codes",
      }
    : {
        dep: "departments", depPk: "dept_id",  depNm: "name",    depBud: "budget",
        ins: "instructors", insPk: "instructor_id", insNm: "name", insDep: "dept_id", insSal: "salary", insExp: "experience_yrs", insAdv: "advisor_id",
        stu: "students",    stuPk: "student_id",   stuNm: "name",    stuDep: "dept_id",   stuYr: "year",  stuAdv: "advisor_id",
        crs: "courses",     crsPk: "course_id",    crsCd: "course_code", crsNm: "course_name", crsDep: "dept_id", crsIns: "instructor_id", crsCred: "credits", crsCap: "capacity",
        enr: "enrollments", enrPk: "enrollment_id", enrStu: "student_id", enrCrs: "course_id", enrGrd: "gpa", enrSem: "semester",
        grading: "gpa",
      };

  const L = [];
  L.push("PRAGMA journal_mode=DELETE;");
  L.push("BEGIN TRANSACTION;");

  // departments
  const departments = [];
  for (let d = 0; d < 8; d++) {
    departments.push({
      id: d + 1,
      name: legacy ? `DEP_${String(d + 1).padStart(2, "0")}` : DEPT_NAMES[d],
      budget: int(rng, 500000, 5000000),
    });
  }

  // instructors with advisor self-reference (every 3rd has an advisor; never self)
  const instructors = [];
  const nInstructors = Math.max(20, Math.floor(nStudents / 40));
  for (let i = 0; i < nInstructors; i++) {
    instructors.push({
      id: i + 1,
      name: legacy ? `${pick(rng, LAST)}, ${pick(rng, FIRST)}` : `Prof. ${pick(rng, FIRST)} ${pick(rng, LAST)}`,
      dept: int(rng, 1, 8),
      salary: int(rng, 40000, 180000),
      experience: int(rng, 1, 35),
      advisor: null,
    });
  }
  instructors.forEach((ins, i) => {
    if (i % 3 === 0) {
      const c = instructors[(i + 5) % instructors.length];
      ins.advisor = c.id !== ins.id ? c.id : null;
    }
  });

  // students — ~12% advisor-less (anti-join population, LITMUS sentinel)
  const students = [];
  for (let s = 0; s < nStudents; s++) {
    const fn = pick(rng, FIRST), ln = pick(rng, LAST);
    students.push({
      id: s + 1,
      name: legacy ? `${ln}, ${fn}` : `${fn} ${ln}`,
      dept: int(rng, 1, 8),
      year: int(rng, 1, 4),
      advisor: rng() < 0.88 ? instructors[int(rng, 0, instructors.length - 1)].id : null,
      gpa: legacy ? null : Math.round(rng() * 4 * 100) / 100,
    });
  }

  // courses
  const courses = [];
  for (let c = 0; c < nCourses; c++) {
    courses.push({
      id: c + 1,
      code: legacy ? `CRS${String(c + 1).padStart(3, "0")}` : `${["CS", "EE", "ME", "CE", "MA", "PH", "CH", "MG"][c % 8]}${300 + c}`,
      name: legacy ? `Course Module ${c + 1}` : COURSE_NAMES[c % COURSE_NAMES.length],
      dept: int(rng, 1, 8),
      instructor: pick(rng, instructors).id,
      credits: int(rng, 2, 5),
      capacity: int(rng, 30, 120),
    });
  }

  // enrollments (the big fact table)
  const enrollments = [];
  let eid = 0;
  for (const s of students) {
    const n = int(rng, 3, 7);
    const chosen = new Set();
    for (let k = 0; k < n; k++) {
      const cid = pick(rng, courses).id;
      if (chosen.has(cid)) continue;
      chosen.add(cid);
      eid++;
      enrollments.push({
        id: eid,
        student: s.id,
        course: cid,
        grade: legacy ? pick(rng, GRADE_CODES) : null,
        gpa: legacy ? null : Math.round(rng() * 4 * 100) / 100,
        semester: legacy ? `${int(rng, 2023, 2025)}${int(rng, 1, 2)}` : `${pick(rng, ["Fall", "Spring"])} ${int(rng, 2023, 2025)}`,
      });
    }
  }

  // ── DDL — entirely through the map ──
  L.push(`CREATE TABLE ${T.dep} (${T.depPk} INTEGER PRIMARY KEY, ${T.depNm} TEXT NOT NULL, ${T.depBud} INTEGER);`);
  departments.forEach(d => L.push(`INSERT INTO ${T.dep} VALUES (${d.id}, '${esc(d.name)}', ${d.budget});`));

  L.push(`CREATE TABLE ${T.ins} (${T.insPk} INTEGER PRIMARY KEY, ${T.insNm} TEXT NOT NULL, ${T.insDep} INTEGER, ${T.insSal} INTEGER, ${T.insExp} INTEGER, ${T.insAdv} INTEGER);`);
  instructors.forEach(i => L.push(`INSERT INTO ${T.ins} VALUES (${i.id}, '${esc(i.name)}', ${i.dept}, ${i.salary}, ${i.experience}, ${i.advisor || "NULL"});`));

  L.push(`CREATE TABLE ${T.stu} (${T.stuPk} INTEGER PRIMARY KEY, ${T.stuNm} TEXT NOT NULL, ${T.stuDep} INTEGER, ${T.stuYr} INTEGER, ${T.stuAdv} INTEGER, ${T.grading === "gpa" ? `${T.enr ? "" : ""}gpa REAL` : "gpa_code TEXT"});`);
  students.forEach(s => L.push(`INSERT INTO ${T.stu} VALUES (${s.id}, '${esc(s.name)}', ${s.dept}, ${s.year}, ${s.advisor || "NULL"}, ${s.gpa ?? "NULL"});`));

  L.push(`CREATE TABLE ${T.crs} (${T.crsPk} INTEGER PRIMARY KEY, ${T.crsCd} TEXT, ${T.crsNm} TEXT, ${T.crsDep} INTEGER, ${T.crsIns} INTEGER, ${T.crsCred} INTEGER, ${T.crsCap} INTEGER);`);
  courses.forEach(c => L.push(`INSERT INTO ${T.crs} VALUES (${c.id}, '${c.code}', '${esc(c.name)}', ${c.dept}, ${c.instructor}, ${c.credits}, ${c.capacity});`));

  L.push(`CREATE TABLE ${T.enr} (${T.enrPk} INTEGER PRIMARY KEY, ${T.enrStu} INTEGER NOT NULL, ${T.enrCrs} INTEGER NOT NULL, ${T.enrGrd} ${T.grading === "gpa" ? "REAL" : "TEXT"}, ${T.enrSem} TEXT);`);
  enrollments.forEach(e => {
    const val = T.grading === "gpa" ? e.gpa : `'${e.grade}'`;
    L.push(`INSERT INTO ${T.enr} VALUES (${e.id}, ${e.student}, ${e.course}, ${val}, '${e.semester}');`);
  });

  L.push(`CREATE INDEX idx_enr_stu ON ${T.enr}(${T.enrStu});`);
  L.push(`CREATE INDEX idx_enr_crs ON ${T.enr}(${T.enrCrs});`);
  L.push(`CREATE INDEX idx_stu_adv ON ${T.stu}(${T.stuAdv});`);

  L.push("COMMIT;");
  const sqlFile = path.join(OUT_DIR, `.gen_${name}.sql`);
  writeFileSync(sqlFile, L.join("\n"));
  execSync(`sqlite3 "${dbPath}" < "${sqlFile}"`);
  rmSync(sqlFile);
  return { dbPath, legacy, T, students, courses, enrollments, instructors, departments };
}

// ═══ GENERATE — 3 sizes ═══
const u1 = generateUniversity({ name: "U1", seed: 91, students: 300, courses: 40, legacy: false });
const u2 = generateUniversity({ name: "U2", seed: 92, students: 3000, courses: 120, legacy: false });
const u3 = generateUniversity({ name: "U3", seed: 93, students: 12000, courses: 300, legacy: true });

// ═══ VERIFICATION — all through T, zero hardcoded names ═══
for (const [label, g] of [["U1_stateuniv (SMALL)", u1], ["U2_metrouniv (MEDIUM)", u2], ["U3_institute (LARGE)", u3]]) {
  console.log(`\n═══ ${label} — ${g.dbPath} ═══`);
  const T = g.T;
  const q = (s) => execSync(`sqlite3 "${g.dbPath}" "${s}"`).toString().trim();

  console.log("departments:", q(`SELECT COUNT(*) FROM ${T.dep};`));
  console.log("instructors:", q(`SELECT COUNT(*) FROM ${T.ins};`));
  console.log("instructors WITH advisor (self-join):", q(`SELECT COUNT(*) FROM ${T.ins} WHERE ${T.insAdv} IS NOT NULL;`));
  console.log("students:", q(`SELECT COUNT(*) FROM ${T.stu};`));
  console.log("enrollments:", q(`SELECT COUNT(*) FROM ${T.enr};`));
  console.log("students WITHOUT advisor (anti-join):", q(`SELECT COUNT(*) FROM ${T.stu} WHERE ${T.stuAdv} IS NULL;`));

  if (T.grading === "gpa") {
    console.log("avg student GPA:", q(`SELECT ROUND(AVG(${T.stuNm === "name" ? "gpa" : "gpa"}),3) FROM ${T.stu};`));
    console.log("top dept by avg student GPA:", q(`SELECT d.${T.depNm}, ROUND(AVG(s.gpa),3) a FROM ${T.stu} s JOIN ${T.dep} d ON s.${T.stuDep}=d.${T.depPk} GROUP BY 1 ORDER BY a DESC LIMIT 1;`));
    console.log("top dept by avg enrollment GPA:", q(`SELECT d.${T.depNm}, ROUND(AVG(e.${T.enrGrd}),3) a FROM ${T.enr} e JOIN ${T.crs} c ON e.${T.enrCrs}=c.${T.crsPk} JOIN ${T.dep} d ON c.${T.crsDep}=d.${T.depPk} GROUP BY 1 ORDER BY a DESC LIMIT 1;`));
  } else {
    console.log("most common grade:", q(`SELECT ${T.enrGrd}, COUNT(*) c FROM ${T.enr} GROUP BY ${T.enrGrd} ORDER BY c DESC LIMIT 1;`));
    console.log("top dept by enrollments:", q(`SELECT c.${T.crsDep}, COUNT(*) c FROM ${T.enr} e JOIN ${T.crs} c ON e.${T.enrCrs}=c.${T.crsPk} GROUP BY 1 ORDER BY c DESC LIMIT 1;`));
  }
  console.log("most popular course:", q(`SELECT ${T.enrCrs}, COUNT(*) c FROM ${T.enr} GROUP BY ${T.enrCrs} ORDER BY c DESC LIMIT 1;`));
}
console.log("\n✅ University realm complete: U1 (small) + U2 (medium) + U3 (large)");