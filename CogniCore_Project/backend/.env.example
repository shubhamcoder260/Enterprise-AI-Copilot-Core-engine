# ==============================================================================
# COGNICORE ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# CAP v2.2 §233, §283 — Security Hardening Specification
# ==============================================================================
#
# ══════════════════════════════════════════════════════════════════════════════
# REQUIRED FOR PRODUCTION (MUST BE SET BEFORE DEPLOYMENT)
# ══════════════════════════════════════════════════════════════════════════════
# 1. COGNICORE_JWT_SECRET       - High-entropy 256-bit secret for signing JWTs
# 2. VAULT_MASTER_KEY           - 32-byte secret passphrase for AES-256-GCM vault
# 3. ERPNEXT_DB_PASSWORD        - Read-only MariaDB database user password
# 4. ERPNEXT16_DB_PASSWORD      - Read-only MariaDB v16 database user password
# 5. PGPASSWORD / POSTGRES_PASSWORD - Read-only PostgreSQL database user password
# 6. ERPNEXT_WRITE_DB_PASSWORD  - Isolated write-adapter MariaDB user password
# 7. PG_WRITE_PASSWORD          - Isolated write-adapter PostgreSQL user password
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# 1. SERVER & RUNTIME CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# Port on which the Express application listens
PORT=5000

# Application environment mode ('development' | 'production' | 'test')
# In production, stack traces and internal 500 error messages are sanitized
NODE_ENV=production

# Permitted CORS origins (comma-separated). Unmatched origins receive no CORS headers.
COGNICORE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ──────────────────────────────────────────────────────────────────────────────
# 2. AUTHENTICATION & SESSION MANAGEMENT (VULN-05, VULN-06)
# ──────────────────────────────────────────────────────────────────────────────
# Cryptographic secret for signing and verifying JSON Web Tokens (HMAC-SHA256).
# Auto-generated on first boot if missing; MUST be set in production.
COGNICORE_JWT_SECRET=replace_with_64_character_hex_or_random_secret_in_production

# JWT expiration window (e.g., '1h', '8h', '1d')
JWT_EXPIRES_IN=8h

# ──────────────────────────────────────────────────────────────────────────────
# 3. CREDENTIAL VAULT & AUTO-PROVISIONING (VULN-07, VULN-10)
# ──────────────────────────────────────────────────────────────────────────────
# Master key used to derive AES-256-GCM encryption keys for data/cognicore_vault.db
# Never commit this key to source control or expose it in logs.
VAULT_MASTER_KEY=replace_with_32_byte_vault_master_key_for_aes256gcm

# Governs POST /api/sources/auto-provision (deprecated). Defaults to false.
# When false, the endpoint returns 410 Gone directing users to manual grant scripts.
ENABLE_AUTO_PROVISION=false

# ──────────────────────────────────────────────────────────────────────────────
# 4. LOCAL LLM INFERENCE (OLLAMA / GEMMA / LLAMA)
# ──────────────────────────────────────────────────────────────────────────────
# Enable local Ollama/OpenAI-compatible inference engine
ENABLE_LOCAL_LLM=true

# URL endpoint for local inference server (e.g. Ollama daemon)
LOCAL_LLM_URL=http://localhost:11434

# Active model identifier for SQL translation and analysis
LOCAL_LLM_MODEL=gemma3:4b

# Inference timeout in milliseconds before cascading to next link
LOCAL_LLM_TIMEOUT_MS=75000

# Keep-alive window for local model memory residence
LOCAL_LLM_KEEP_ALIVE=30m

# Fallback cloud LLM provider API keys (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ──────────────────────────────────────────────────────────────────────────────
# 5. DATA SOURCE: MARIADB / ERPNEXT (READ-ONLY)
# Security: Restricted to read-only queries with RLS enforcement
# ──────────────────────────────────────────────────────────────────────────────
ERPNEXT_DB_HOST=127.0.0.1
ERPNEXT_DB_PORT=3306
ERPNEXT_DB_USER=cognicore_ro
ERPNEXT_DB_PASSWORD=replace_with_production_mariadb_password
ERPNEXT_DB_NAME=_4e5d6a7b8c9d0e1f

# ERPNext REST API Channel 2 keys for schema metadata inspection
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# 6. DATA SOURCE: MARIADB / ERPNEXT v16 (SECONDARY BENCHMARK)
# ──────────────────────────────────────────────────────────────────────────────
ERPNEXT16_DB_HOST=127.0.0.1
ERPNEXT16_DB_PORT=3307
ERPNEXT16_DB_USER=cognicore_ro
ERPNEXT16_DB_PASSWORD=replace_with_production_mariadb16_password
ERPNEXT16_DB_NAME=_210a92d8bfbfc131

# ──────────────────────────────────────────────────────────────────────────────
# 7. DATA SOURCE: POSTGRESQL (READ-ONLY)
# Security: Read-only role with table allowlist gating
# ──────────────────────────────────────────────────────────────────────────────
PGHOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
PGPORT=5432
POSTGRES_PORT=5432
PGUSER=cognicore_ro
POSTGRES_USER=cognicore_ro
PGPASSWORD=replace_with_production_postgres_password
POSTGRES_PASSWORD=replace_with_production_postgres_password
PGDATABASE=cognicore_pg_test
POSTGRES_DB=cognicore_pg_test

# ──────────────────────────────────────────────────────────────────────────────
# 8. DATA SOURCE: WRITE ADAPTERS (ISOLATED WRITE PIPELINE)
# Security: Segregated credentials, strictly reserved for ActionGateway after approval
# ──────────────────────────────────────────────────────────────────────────────
ERPNEXT_WRITE_DB_HOST=127.0.0.1
ERPNEXT_WRITE_DB_PORT=3306
ERPNEXT_WRITE_DB_USER=cognicore_write
ERPNEXT_WRITE_DB_PASSWORD=replace_with_production_mariadb_write_password
ERPNEXT_WRITE_DB_NAME=_4e5d6a7b8c9d0e1f

PG_WRITE_HOST=127.0.0.1
PG_WRITE_PORT=5432
PG_WRITE_USER=cognicore_write
PG_WRITE_PASSWORD=replace_with_production_pg_write_password
PG_WRITE_DB=cognicore_pg_test
